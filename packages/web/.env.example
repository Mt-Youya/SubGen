# ── ASR 语音识别（三选一或多选，自动 fallback）────────────────────────
# 优先级：Groq → Cloudflare → SiliconFlow

# Groq — whisper-large-v3-turbo，最快，免费，部分地区封锁
# 注册：https://console.groq.com
GROQ_API_KEY=

# Cloudflare Workers AI — whisper-large-v3-turbo，全球可用，$0.00045/min
# 注册：https://dash.cloudflare.com → AI → Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 硅基流动 — SenseVoiceSmall，全球可用，兜底（无精确时间戳）
# 注册：https://siliconflow.cn
SILICONFLOW_API_KEY=

# ── 翻译 ──────────────────────────────────────────────────────────────
# 腾讯云机器翻译（500万字符/月免费）
# 注册：https://console.cloud.tencent.com → 机器翻译
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── 缓存（可选）──────────────────────────────────────────────────────
# Upstash Redis — 跨实例持久缓存，同一文件不重复识别（免费：10k 请求/天）
# 开通：vercel.com → Project → Storage → Upstash → Create → 自动注入以下变量
KV_REST_API_URL=
KV_REST_API_TOKEN=
