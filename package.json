{
  "name": "subgen",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter @subgen/desktop dev",
    "dev:desktop:mac": "pnpm --filter @subgen/desktop dev:mac",
    "build": "pnpm --filter shared build && pnpm --filter web build",
    "build:desktop": "pnpm --filter @subgen/desktop build",
    "lint": "pnpm -r lint",
    "preview": "pnpm --filter web build && pnpm --filter web start",
    "clean": "find . -name 'node_modules' -type d -not -path '*/.git/*' | xargs rm -rf",
    "clear:all": "rm -rf node_modules pnpm-lock.yaml && pnpm -r exec rm -rf dist node_modules pnpm-lock.yaml"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "prettier": {
    "printWidth": 120
  }
}
